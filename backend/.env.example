# Backend Environment Variables
# Copy this file to .env and fill in your values

# --- Server ---
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# --- MongoDB ---
MONGODB_URI=mongodb://localhost:27017/reachinbox_db

# --- Redis (BullMQ) ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# --- JWT ---
JWT_SECRET=change_this_to_a_long_random_secret_string

# --- SMTP (Ethereal fake SMTP - credentials auto-created on first run if left blank) ---
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=ReachInbox Scheduler <scheduler@reachinbox.test>

# --- Worker ---
# Set to false to run worker as a separate process (npm run worker)
RUN_IN_PROCESS_WORKER=true
WORKER_CONCURRENCY=5

# --- Rate Limiting ---
DEFAULT_SENDER_HOURLY_LIMIT=50
AUTH_RATE_LIMIT_MAX=30
API_RATE_LIMIT_MAX=200

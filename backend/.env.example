PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# PostgreSQL Database URL
DATABASE_URL="postgresql://reachinbox_user:reachinbox_password@localhost:5432/reachinbox_db?schema=public"

# Redis Configuration (Used by BullMQ & Persistent Rate Limiting)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Elasticsearch Configuration
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_INDEX=reachinbox_emails

# JWT Secret (Set a strong random secret in production)
JWT_SECRET=reachinbox_super_secret_jwt_key_2026

# Google OAuth Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# Slack OAuth & Notifications
SLACK_CLIENT_ID=your_slack_client_id_here
SLACK_CLIENT_SECRET=your_slack_client_secret_here
SLACK_REDIRECT_URI=http://localhost:5000/api/auth/slack/callback
SLACK_WEBHOOK_URL=

# Nodemailer / Ethereal Email (Auto-configured if left blank in development)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=ReachInbox Scheduler <scheduler@reachinbox.test>

# Worker & Rate Limit Tuning
WORKER_CONCURRENCY=5
DEFAULT_SENDER_HOURLY_LIMIT=50
AUTH_RATE_LIMIT_MAX=30
API_RATE_LIMIT_MAX=200

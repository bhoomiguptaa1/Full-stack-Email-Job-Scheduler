# ============================================================
# PRODUCTION ENVIRONMENT VARIABLES
# Copy these into Vercel / Railway dashboard — never commit real values
# ============================================================

# --- App ---
NODE_ENV=production
PORT=3001
FRONTEND_URL=https://your-frontend.vercel.app

# --- JWT ---
JWT_SECRET=generate_a_64_char_random_string_here

# --- PostgreSQL (Neon — free tier) ---
# Get from: https://neon.tech  → New Project → Connection String
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require

# --- Redis (Upstash — free tier) ---
# Get from: https://console.upstash.com → Create Database → .env tab
REDIS_URL=rediss://default:password@xxx.upstash.io:6379

# --- Elasticsearch (Bonsai — free 125 MB) ---
# Get from: https://bonsai.io → Create Cluster → Access → Credentials
ELASTICSEARCH_URL=https://user:password@xxx.bonsaisearch.net:443
# Leave blank to disable Elasticsearch (uses PostgreSQL fallback)
# ELASTICSEARCH_URL=

# --- Nodemailer / Ethereal (auto-created if blank) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- Google OAuth ---
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://your-backend.vercel.app/api/auth/google/callback

# --- Slack OAuth ---
SLACK_CLIENT_ID=your_slack_client_id
SLACK_CLIENT_SECRET=your_slack_client_secret
SLACK_REDIRECT_URI=https://your-backend.vercel.app/api/auth/slack/callback
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# --- Rate limits & Worker ---
WORKER_CONCURRENCY=2
DEFAULT_SENDER_HOURLY_LIMIT=100
AUTH_RATE_LIMIT_MAX=20
API_RATE_LIMIT_MAX=200

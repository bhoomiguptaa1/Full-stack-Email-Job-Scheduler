{
  "name": "reachinbox-scheduler-backend",
  "version": "1.0.0",
  "description": "Backend API & BullMQ Worker for ReachInbox Email Job Scheduler",
  "main": "src/index.js",
  "scripts": {
    "dev":        "nodemon src/index.js",
    "worker":     "nodemon src/worker.js",
    "start":      "node src/index.js",
    "start:worker": "node src/worker.js",
    "test":       "node --test tests/*.test.js"
  },
  "dependencies": {
    "@bull-board/api":     "^6.7.0",
    "@bull-board/express": "^6.7.0",
    "bcryptjs":            "^2.4.3",
    "bullmq":              "^5.25.0",
    "cors":                "^2.8.5",
    "dotenv":              "^16.4.7",
    "express":             "^4.21.1",
    "helmet":              "^8.0.0",
    "ioredis":             "^5.4.1",
    "jsonwebtoken":        "^9.0.2",
    "mongoose":            "^8.8.0",
    "morgan":              "^1.10.0",
    "nodemailer":          "^6.9.16",
    "zod":                 "^3.23.8"
  },
  "devDependencies": {
    "nodemon": "^3.1.7"
  }
}
